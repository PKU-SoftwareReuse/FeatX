# Docker Compose configuration for the ASE 2026 artifact.
# Copy this file to .env in the artifact repository root before running
# docker compose. Manual deployment does not use this file directly; configure
# the backend and RepoSummary files described in README.md instead.
#
# The smoke checks, seeded-data inspection, and non-LLM UI example do not
# require real LLM keys. Add reviewer-only keys only when exercising
# LLM-backed feature extraction or code evolution.

# Configure unversioned API roots; FeatX appends /v1 internally.
LLM_API_URL=https://api.deepseek.com
LLM_API_KEY=
AGENT_LOGS_ENABLED=true

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_API_MODEL=deepseek-v4-pro
FEATX_MODELS_HOST=./models
SENTENCE_TRANSFORMER_MODEL_HOST=./models/sentence-transformers
SENTENCE_TRANSFORMER_MODEL=/app/models/sentence-transformers/all-mpnet-base-v2
PYTHON_SENTENCE_TRANSFORMER_MODEL=/app/models/sentence-transformers/all-mpnet-base-v2
CODET5_MODEL=/app/models/transformers/Salesforce/codet5-base-multi-sum
PYTHON_CODET5_MODEL=/app/models/transformers/Salesforce/codet5-base-multi-sum
REPOSUMMARY_PYTHON_USE_CODET5=true
REPOSUMMARY_CODET5_BATCH_SIZE=16
REPOSUMMARY_CODET5_MAX_INPUT_TOKENS=512
REPOSUMMARY_CODET5_MAX_OUTPUT_TOKENS=40

FOCUSGRAPH_TOP_K_FEATURES=3
FOCUSGRAPH_TOP_K_NODES=15
FOCUSGRAPH_EMBEDDING_MODEL=/app/models/sentence-transformers/all-mpnet-base-v2
FOCUSGRAPH_FEATURE_EMBEDDING_MODEL=/app/models/sentence-transformers/all-MiniLM-L6-v2
FOCUSGRAPH_GRAPH_EMBEDDING_BACKEND=bge-code
FOCUSGRAPH_GRAPH_EMBEDDING_MODEL=/app/models/sentence-transformers/BAAI/bge-code-v1
FOCUSGRAPH_GRAPH_EMBEDDING_BATCH_SIZE=16
FOCUSGRAPH_BGE_MAX_SEQ_LENGTH=4096
JAVA_GRAPH_CONTEXT_TIMEOUT_SECONDS=900
JAVA_AGENT_MAX_CORE_CONTEXT_CHARS=0
JAVA_AGENT_MAX_REFERENCE_CONTEXT_CHARS=0
REPOSUMMARY_GENERATE_DESCRIPTION=true
REPOSUMMARY_LLM_TIMEOUT_SECONDS=20
REPOSUMMARY_PYTHON_LLM_MAX_WORKERS=4
REPOSUMMARY_LLM_MAX_TOKENS=
REPOSUMMARY_LLM_RETRY_ATTEMPTS=2
REPOSUMMARY_DESCRIPTION_PROGRESS_INTERVAL_SECONDS=10
REPOSUMMARY_EMBEDDING_ALLOW_DOWNLOAD=false

# These MySQL values are used inside Docker Compose. The recommended review
# path does not require a host-installed MySQL server.
MYSQL_ROOT_PASSWORD=featx_root
MYSQL_DATABASE=lotm
MYSQL_USER=featx
MYSQL_PASSWORD=featx

# Override these only if the default host ports are already in use.
BACKEND_PORT=8080
FRONTEND_PORT=3000
FEATX_UPLOAD_MAX_SIZE=100m
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=100MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=100MB

# Default UI language for users without a saved preference: CN or EN.
REACT_APP_DEFAULT_LANGUAGE=CN

# Optional Git proxy for cloning repositories from the welcome page.
# If your host proxy listens on 127.0.0.1:7890, set GIT_PROXY_PORT=7890.
# The runner rewrites localhost/10.0.2.2 to the host IPv4 when needed.
GIT_PROXY_HOST=
GIT_PROXY_PORT=
