# 当前本机开发配置；修改服务地址或共享路径后执行 ./dev.sh restart。
# RepoSummary 服务根地址：填写后使用该服务；留空使用内置服务（127.0.0.1:18091）。
# 示例：REPOSUMMARY_HTTP_URL=http://127.0.0.1:8000（将 8000 替换为同门实际端口）
# 修改后执行 ./dev.sh restart；外部服务不可达时会报错，不自动切换。
REPOSUMMARY_HTTP_URL=
SHARED_PROJECT_ROOT=/home/lixutian/Projects_SSD/FeatX-shared

# GitHub 代理；留空或删除此项时直连。修改后对新 Git 请求立即生效。
GITHUB_PROXY_URL=http://127.0.0.1:13280
GIT_CLONE_TIMEOUT_SECONDS=300
