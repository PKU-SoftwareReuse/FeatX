# Docker Compose configuration. Copy this file to .env for the recommended
# Docker deployment path. Manual deployment does not use this file directly;
# configure the backend and RepoSummary files described in README.md instead.
#
# The smoke checks and UI startup do not require a real LLM key. Add keys only
# if you want to exercise LLM-backed feature extraction or code evolution.

LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_API_MODEL=deepseek-v4-pro

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_API_MODEL=deepseek-v4-pro
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-mpnet-base-v2

# These MySQL values are used inside Docker Compose. The recommended Docker
# path does not require a host-installed MySQL server.
MYSQL_ROOT_PASSWORD=featx_root
MYSQL_DATABASE=lotm
MYSQL_USER=featx
MYSQL_PASSWORD=featx

# Override these only if the default host ports are already in use.
BACKEND_PORT=8080
FRONTEND_PORT=3000
