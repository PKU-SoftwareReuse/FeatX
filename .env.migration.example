# Copy this file to .env.migration and fill in the source MySQL connection.
# Do not commit .env.migration because it contains credentials.

# Source MySQL instance, usually the existing FeatX server.
SOURCE_MYSQL_HOST=example.com
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_DATABASE=lotm
SOURCE_MYSQL_USER=featx
SOURCE_MYSQL_PASSWORD=

# Optional. Common values: DISABLED, PREFERRED, REQUIRED.
# Leave as PREFERRED unless the remote server requires a different mode.
SOURCE_MYSQL_SSL_MODE=PREFERRED

# Target Docker Compose MySQL instance for this artifact package.
TARGET_COMPOSE_PROJECT=featx_ae_verify
TARGET_MYSQL_CONTAINER=featx_ae_verify-mysql-1
TARGET_MYSQL_DATABASE=lotm
TARGET_MYSQL_USER=featx
TARGET_MYSQL_PASSWORD=featx

# Optional Docker command override. Keep "docker" for normal setups.
# If needed, run with: DOCKER_BIN="docker --context <name>" scripts/migrate_mysql_data.sh inspect
DOCKER_BIN=docker

# Set to 1 only after manually reviewing a schema diff.
ALLOW_SCHEMA_DIFF=0
