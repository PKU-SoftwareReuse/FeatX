#!/usr/bin/env python3
"""Run FeatX's pinned Codex with its native config and authentication."""
import os
from pathlib import Path

root = Path(__file__).resolve().parents[2]
home = root / 'data/codex-home'
home.mkdir(parents=True, exist_ok=True)
os.environ['CODEX_HOME'] = str(home)
binary = Path(__file__).parent / 'node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex'
if not binary.exists():
    raise SystemExit('请先运行 npm ci --prefix tools/codex')
os.execv(str(binary), [str(binary), *os.sys.argv[1:]])
